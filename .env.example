# Copy values into your shell or a local .env file. Never commit real credentials.
EIA_API_KEY=
ENTSOE_API_TOKEN=
EMBER_API_KEY=
# Copernicus Climate Data Store (CDS) — used by the scientific geospatial extractor.
# cdsapi also accepts CDSAPI_URL / CDSAPI_KEY or a ~/.cdsapirc file.
CDS_API_KEY=
CDSAPI_URL=https://cds.climate.copernicus.eu/api
